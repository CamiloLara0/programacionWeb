{
  "name": "programacionWeb - Altiora CRUD",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": { "label": "Altiora React", "onAutoForward": "openBrowser" },
    "3001": { "label": "Altiora API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "cd altiora-crud && npm install"
}