{
  "name": "Altiora React CRUD",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": { "label": "React frontend", "onAutoForward": "openBrowser" },
    "3001": { "label": "json-server API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm install"
}